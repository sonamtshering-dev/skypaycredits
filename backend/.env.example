# ─────────────────────────────────────────────────
# Environment Variables — copy to .env and fill in
# ─────────────────────────────────────────────────

# MongoDB
MONGO_URI=mongodb://localhost:27017/rechargeshop

# JWT
JWT_SECRET=your_very_long_random_secret_here

# Email OTP (Gmail app password)
EMAIL_USER=you@gmail.com
EMAIL_PASS=your_app_password

# NovaPay Payment Gateway
NOVAPAY_API_KEY=upay_your_key_here
NOVAPAY_API_SECRET=your_secret_here
NOVAPAY_WEBHOOK_SECRET=your_webhook_secret_here   # REQUIRED in production

# FinTopup Callback Security (set at least one in production)
FINTOPUP_CALLBACK_SECRET=your_shared_secret_here  # must match X-Fintopup-Secret header FinTopup sends
FINTOPUP_ALLOWED_IPS=                              # optional comma-separated IP allowlist

# Moogold Provider
MOOGOLD_API_KEY=your_moogold_api_key
MOOGOLD_BASE_URL=https://moogold.com/wp-json/v1/api

# Smile.One Provider
# SMILE_BASE_URL: use https://www.smile.one (root — works for BR accounts)
# Do NOT append /ph or /smilecoin/api — the code adds /smilecoin/api automatically
SMILE_UID=your_uid_number
SMILE_EMAIL=your_smile_email
SMILE_API_KEY=your_smile_api_key
SMILE_BASE_URL=https://www.smile.one

# App
PORT=5001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
